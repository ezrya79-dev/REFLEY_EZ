# .env de PRODUCTION — Refley. À copier en /var/www/refley/.env
# puis compléter. Ne JAMAIS committer ce fichier rempli.
APP_NAME="Refley"
APP_ENV=production
APP_KEY=            # php artisan key:generate
APP_DEBUG=false
APP_TIMEZONE=Europe/Paris
APP_URL=https://refley.joefr.cloud

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

# Version affichée (posées par deploy.sh à partir du tag git).
# APP_RELEASE_VERSION=
# APP_RELEASE_DATE=

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=refley
DB_USERNAME=refley
DB_PASSWORD=        # créé au provisionnement (vps-provision)

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contact@refley.joefr.cloud"
MAIL_FROM_NAME="${APP_NAME}"
