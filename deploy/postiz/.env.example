# ============================================================================
# Postiz — variables d'environnement
#
# NE PAS remplir ce fichier : lancer  scripts/03-generate-env.sh  qui crée
# le vrai fichier .env avec des secrets forts (le .env n'est JAMAIS commité,
# ce dépôt est public).
#
# Règle : valeurs sans espaces ni caractères spéciaux d'URL (@ : / # ?)
# pour POSTGRES_PASSWORD (il est injecté dans DATABASE_URL).
# ============================================================================

# --- URLs publiques ---------------------------------------------------------
# Avec domaine + HTTPS (production) :
#   MAIN_URL=https://postiz.mondomaine.com
#   FRONTEND_URL=https://postiz.mondomaine.com
#   NEXT_PUBLIC_BACKEND_URL=https://postiz.mondomaine.com/api
# Sans domaine (accès temporaire via tunnel SSH uniquement) :
MAIN_URL=http://localhost:4007
FRONTEND_URL=http://localhost:4007
NEXT_PUBLIC_BACKEND_URL=http://localhost:4007/api

# --- Secrets (générés par 03-generate-env.sh) -------------------------------
JWT_SECRET=CHANGE_ME_openssl_rand_hex_64
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24

# --- Base de données --------------------------------------------------------
POSTGRES_USER=postiz-user
POSTGRES_DB=postiz-db-local

# --- Comportement -----------------------------------------------------------
# Passer à true APRÈS la création du premier compte admin, puis :
#   docker compose up -d postiz
DISABLE_REGISTRATION=false

# Limite de l'API publique / MCP : requêtes par heure et par clé.
# À augmenter (ex. 120) quand plusieurs apps métier utiliseront l'API.
API_LIMIT=30

# --- Image / ports locaux ---------------------------------------------------
# Figer une version précise (ex. v2.12.0) est plus sûr que latest en prod.
POSTIZ_IMAGE_TAG=latest
# Ports publiés sur 127.0.0.1 uniquement — changer si déjà occupés (cf. audit).
POSTIZ_BIND_PORT=4007
TEMPORAL_BIND_PORT=7233
TEMPORAL_UI_BIND_PORT=8080

# --- Clés plateformes sociales (optionnel, à remplir au fur et à mesure) ----
# Doc par plateforme : https://docs.postiz.com/providers/overview
X_API_KEY=
X_API_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BEEHIIVE_API_KEY=
BEEHIIVE_PUBLICATION_ID=
THREADS_APP_ID=
THREADS_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Instagram « Standalone » (connexion directe sans page Facebook — compte pro requis)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
DRIBBBLE_CLIENT_ID=
DRIBBBLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN_ID=
SLACK_ID=
SLACK_SECRET=
SLACK_SIGNING_SECRET=
MASTODON_URL=https://mastodon.social
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=

# --- Divers -----------------------------------------------------------------
# Uniquement pour les fonctions IA internes de Postiz (pas nécessaire pour MCP)
OPENAI_API_KEY=
