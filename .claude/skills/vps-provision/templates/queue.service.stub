# Worker de queue {{APP_NAME}} (optionnel mais recommandé).
#
# À copier dans /etc/systemd/system/{{APP_SLUG}}-queue.service puis :
#   systemctl daemon-reload
#   systemctl enable --now {{APP_SLUG}}-queue
#
# Le déploiement appelle `php artisan queue:restart`, ce qui demande au worker
# de redémarrer proprement pour charger le nouveau code (systemd le relance).
#
# Adaptez User/Group et le chemin PHP si besoin.

[Unit]
Description={{APP_NAME}} queue worker
After=network.target mysql.service

[Service]
User=www-data
Group=www-data
Restart=always
RestartSec=3
WorkingDirectory=/var/www/{{APP_SLUG}}
ExecStart=/usr/bin/php /var/www/{{APP_SLUG}}/artisan queue:work --sleep=3 --tries=3 --max-time=3600
# Redémarrage propre demandé par `artisan queue:restart` pendant le déploiement
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
