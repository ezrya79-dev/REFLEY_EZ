<?php

namespace App\Enums;

enum UserRole: string
{
    case Admin = 'admin';
    case Manager = 'manager';   // adaptez les rôles à votre organisation
    case Staff = 'staff';

    public function labelKey(): string
    {
        return 'role'.ucfirst($this->value);
    }

    /**
     * Permissions accordées au rôle (source unique de vérité du RBAC).
     * L'administrateur reçoit toutes les permissions via un Gate::before,
     * mais la liste reste exhaustive pour l'affichage et les tests.
     *
     * @return array<int, Permission>
     */
    public function permissions(): array
    {
        return match ($this) {
            self::Admin => Permission::cases(),
            self::Manager => [
                Permission::ViewRecords,
                Permission::UpdateRecord,
                Permission::ExportRecord,
                Permission::ViewMetrics,
            ],
            self::Staff => [
                Permission::ViewRecords,
                Permission::UpdateRecord,
            ],
        };
    }

    public function hasPermission(Permission $permission): bool
    {
        return in_array($permission, $this->permissions(), true);
    }
}
